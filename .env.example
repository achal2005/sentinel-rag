# --- Postgres (pgvector) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONNECT_TIMEOUT=5
# Optional: overrides the individual POSTGRES_* vars if set.
# DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel

# --- Model providers ---
SUPPORT_PRODUCT_NAME=Meridian
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# Required only when either provider is set to gemini. Never expose this in frontend code.
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=90
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2:3b
EMBED_DIM=768

# --- Tools (n8n "hands") ---
# Host port n8n is published on (5678 is often taken by another local n8n).
N8N_HOST_PORT=5679
# Base URL of the n8n webhook listener. From the host use localhost:5679; inside
# the compose network use http://n8n:5678/webhook.
N8N_WEBHOOK_BASE=http://localhost:5679/webhook

# --- Retrieval / answering ---
RETRIEVAL_POOL=20          # candidates pulled from each retriever before fusion
RETRIEVAL_TOPK=5           # chunks passed to the answerer
RRF_K=60                   # reciprocal-rank-fusion constant
CONFIDENCE_MIN=0.55        # min cosine similarity (0..1) for top hit; below -> escalate

# --- Cost / trace logging ---
TRACE_ENABLED=1            # log one row per graph run to the `runs` table (0 to disable)
# Set these to the selected hosted model's USD price per 1M tokens. Leave both
# at zero for local Ollama or when you do not want estimated cost reporting.
COST_PER_1M_INPUT=0.0
COST_PER_1M_OUTPUT=0.0

# --- Langfuse tracing (self-hosted, optional) ---
# One rich trace per graph run (router -> chunks -> prompt -> tool -> cost).
# The langfuse service in docker-compose auto-provisions a project with THESE
# keys on first boot (LANGFUSE_INIT_*), so the backend can trace out of the box.
LANGFUSE_ENABLED=1
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-sentinel-local
LANGFUSE_SECRET_KEY=sk-lf-sentinel-local

# --- Deployment / safety (see DEPLOY.md) ---
# HTTP Basic auth for the API and the console. Leave BOTH empty for local dev
# (no login). Set BOTH before exposing the app publicly. The Next.js proxy sends
# the same pair upstream, so the console keeps working end to end.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
# Browser origins allowed to call the API directly (comma-separated). Set to the
# console's public origin in a hosted deploy.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Simulate tool execution instead of firing real n8n webhooks. Recommended (1)
# for a public demo so approvals never cause a real side effect; 0 for real n8n.
TOOLS_SIMULATE=0
# Host port the operator console is published on (docker-compose.prod.yml).
FRONTEND_PORT=3000
