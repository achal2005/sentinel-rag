# --- Postgres (pgvector) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: overrides the individual POSTGRES_* vars if set.
# DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel

# --- Ollama (local models) ---
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2:3b
EMBED_DIM=768

# --- Tools (n8n "hands") ---
# Host port n8n is published on (5678 is often taken by another local n8n).
N8N_HOST_PORT=5679
# Base URL of the n8n webhook listener. From the host use localhost:5679; inside
# the compose network use http://n8n:5678/webhook.
N8N_WEBHOOK_BASE=http://localhost:5679/webhook

# --- Retrieval / answering ---
RETRIEVAL_POOL=20          # candidates pulled from each retriever before fusion
RETRIEVAL_TOPK=5           # chunks passed to the answerer
RRF_K=60                   # reciprocal-rank-fusion constant
CONFIDENCE_MIN=0.55        # min cosine similarity (0..1) for top hit; below -> escalate
